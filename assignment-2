import time

# Original method using +
def build_plus(parts):
    text = ""
    for p in parts:
        text += p + "\n"
    return text


# Redesigned method using join()
def build_join(parts):
    return "\n".join(parts) + ("\n" if parts else "")


# Function to calculate average execution time
def measure(func, parts):
    times = []
    result = ""

    for i in range(3):
        start = time.perf_counter()
        result = func(parts)
        end = time.perf_counter()
        times.append(end - start)

    return result, sum(times) / 3


# Test with different input sizes
for n in [1000, 10000, 200000]:

    items = [f"Item{i}: Rs{i % 50}" for i in range(n)]

    a, t_plus = measure(build_plus, items)
    b, t_join = measure(build_join, items)

    print("\nNumber of lines:", n)
    print("Same text:", a == b)
    print("Text length:", len(b))
    print("Plus average time: {:.6f} seconds".format(t_plus))
    print("Join average time: {:.6f} seconds".format(t_join))

    if t_join < t_plus:
        print("join() is faster")
    else:
        print("+= is faster in this test")

# Performance measurement
def test_performance(n):
    data = [
        {
            "name": f"Person {i}",
            "phone": str(9000000000 + i),
            "emails": [f"user{i}@gmail.com"]
        }
        for i in range(n)
    ]

    start = time.perf_counter()
    merged = merge_contacts(data)
    end = time.perf_counter()

    print("\nInput contacts:", n)
    print("Merged contacts:", len(merged))
    print("Execution time: {:.6f} seconds".format(end - start))


test_performance(1000)
test_performance(100000)

import time
import re

# Normalize phone numbers
def normalize_phone(phone):
    digits = re.sub(r"\D", "", str(phone))

    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]
    elif len(digits) == 11 and digits.startswith("0"):
        digits = digits[1:]

    return digits


# Normalize names
def normalize_name(name):
    return name.strip().lower()


# Merge contacts
def merge_contacts(contacts):
    records = {}
    phone_index = {}
    next_id = 0

    for contact in contacts:

        name = contact.get("name", "").strip()

        raw_phones = contact.get("phones", [])
        if isinstance(raw_phones, str):
            raw_phones = [raw_phones]

        if contact.get("phone"):
            raw_phones = raw_phones + [contact["phone"]]

        phones = {
            normalize_phone(p)
            for p in raw_phones if p
        }
        phones = {p for p in phones if p}

        raw_emails = contact.get("emails", [])
        if isinstance(raw_emails, str):
            raw_emails = [raw_emails]

        emails = {
            e.strip().lower()
            for e in raw_emails if e.strip()
        }

        # Find existing matching contacts
        matches = {
            phone_index[p]
            for p in phones if p in phone_index
        }

        if not matches:
            record_id = next_id
            next_id += 1

            records[record_id] = {
                "names": set(),
                "phones": set(),
                "emails": set()
            }
        else:
            record_id = min(matches)

            # Merge previously separate records
            for old_id in matches:
                if old_id != record_id:
                    records[record_id]["names"].update(
                        records[old_id]["names"])
                    records[record_id]["phones"].update(
                        records[old_id]["phones"])
                    records[record_id]["emails"].update(
                        records[old_id]["emails"])

                    del records[old_id]

        # Add new information
        if name:
            records[record_id]["names"].add(name)

        records[record_id]["phones"].update(phones)
        records[record_id]["emails"].update(emails)

        # Update phone index
        for p in records[record_id]["phones"]:
            phone_index[p] = record_id

    return list(records.values())


